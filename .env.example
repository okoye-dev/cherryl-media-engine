# ==============================================================================
# Cherryl Media Engine — Environment Configuration
# ==============================================================================

PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=
# The admin account. Set both to create it (or reset its password) on every start. Password: 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 1. Supabase PostgreSQL & Auth (ECC ES256)
# Format: postgres://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_KEY_ID=
SUPABASE_JWT_PUBLIC_KEY_X=
SUPABASE_JWT_PUBLIC_KEY_Y=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 2. Cloudflare R2 (S3 Compatible Storage)
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Public CDN bucket URL format: https://pub-<hash>.r2.dev or https://media.cherrylmedia.com
S3_PUBLIC_URL=https://pub-ceebfc5378214f48bb3d7ec7b50b0901.r2.dev
S3_USE_SSL=true
S3_FORCE_PATH_STYLE=false
