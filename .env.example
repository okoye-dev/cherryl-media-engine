# ==============================================================================
# Cherryl Media Engine — Environment Configuration
# ==============================================================================

PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=cherryl_production_secret_key_change_in_prod

# 1. Supabase PostgreSQL
# Format: postgres://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# 2. Cloudflare R2 (S3 Compatible Storage)
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=cherryl-media-public
# Public CDN bucket URL format: https://pub-<hash>.r2.dev or https://media.cherrylmedia.com
S3_PUBLIC_URL=https://pub-ceebfc5378214f48bb3d7ec7b50b0901.r2.dev
S3_USE_SSL=true
S3_FORCE_PATH_STYLE=false
